{
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm depcruise)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm spec:check)",
      "Bash(pnpm buf:*)",
      "Bash(pnpm catalog:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./deploy/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.(ts|tsx|json)$' | xargs -r pnpm exec biome check --write --no-errors-on-unmatched"
          }
        ]
      }
    ]
  }
}
